# ⚠️ SECURITY WARNING: Never commit this file with real values to git
# Copy to .env and fill in your own STRONG values

# === DATABASE CONFIGURATION ===
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# IMPORTANT: Use a strong password! Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD
DB_NAME=mouhamed_vj

# === JWT/AUTHENTICATION ===
# CRITICAL: Use a strong random secret! Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_STRONG_RANDOM_SECRET_64_CHARS_MIN
JWT_EXPIRATION=15m

# === ADMIN USER ===
# Password for initial admin account (only used during seed)
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# === SERVER CONFIGURATION ===
PORT=3000
NODE_ENV=development

# === FILE UPLOADS ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# === CORS (Production: use your actual domain) ===
CORS_ORIGIN=http://localhost:5173
